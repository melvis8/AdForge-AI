generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String?    @unique
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
}

model Campaign {
  id          String          @id @default(uuid())
  title       String?
  description String?
  status      String          @default("draft") // draft, generating, completed, failed
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  assets      Asset[]
  jobs        Job[]
  generated   GeneratedFile[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Asset {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  url        String
  type       String // image, logo, voice_input
  createdAt  DateTime @default(now())
}

model GeneratedFile {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  url        String
  type       String // poster, video, voice, caption
  content    String? // for text like captions or suggestions
  createdAt  DateTime @default(now())
}

model Job {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  taskType   String // image_analysis, marketing_strategy, etc.
  status     String   @default("pending") // pending, running, completed, failed
  result     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OfflineTemplate {
  id        String   @id @default(uuid())
  category  String // restaurant, fashion, beauty
  content   String
  type      String // caption, hashtag, idea
  createdAt DateTime @default(now())
}
